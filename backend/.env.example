# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Example for a local named instance with SQL auth:
# DATABASE_URL=mssql+pyodbc://sa:YourPassword123@localhost\SQLEXPRESS/FootballIndustryDB?driver=ODBC+Driver+17+for+SQL+Server
# Example for Windows Authentication against the default local instance:
# DATABASE_URL=mssql+pyodbc://localhost/FootballIndustryDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
DATABASE_URL=mssql+pyodbc://localhost%5CSQLEXPRESS/FootballIndustryDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# --- Auth ---
SECRET_KEY=change_this_to_a_long_random_string_before_running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- n8n webhooks (leave blank to disable) ---
# Paste the "Production URL" (or "Test URL" while building) shown on each
# n8n Webhook trigger node after you import n8n/workflows/*.json.
N8N_NEW_EXPORT_ORDER_WEBHOOK=http://localhost:5678/webhook/new-export-order
N8N_SHIPMENT_UPDATE_WEBHOOK=http://localhost:5678/webhook/shipment-update
# Shared secret n8n sends back to FastAPI for the Scheduled Report workflow
N8N_AUTOMATION_KEY=change_this_shared_secret

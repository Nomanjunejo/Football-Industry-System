{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Setup (run once)",
      "type": "shell",
      "command": "${workspaceFolder}/setup.sh",
      "windows": { "command": "${workspaceFolder}\\setup.bat" },
      "problemMatcher": []
    },
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "source venv/bin/activate && uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "windows": {
        "command": "venv\\Scripts\\activate && uvicorn app.main:app --reload --port 8000",
        "options": { "cwd": "${workspaceFolder}\\backend" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "Run n8n",
      "type": "shell",
      "command": "npx n8n",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "2. Run Everything (Backend + Frontend + n8n)",
      "dependsOn": ["Run Backend", "Run Frontend", "Run n8n"],
      "problemMatcher": []
    }
  ]
}

{
  "name": "Low Stock Alert",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "schedule1",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/api/analytics/low-stock/automation",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Automation-Key", "value": "change_this_shared_secret" }
          ]
        }
      },
      "id": "httpRequest1",
      "name": "Get Low Stock Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{$json.length}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if1",
      "name": "Any Low Stock Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all()[0].json;\nconst lines = items.map(i => `- ${i.ProductName} @ ${i.WarehouseName}: ${i.Quantity} left (reorder at ${i.ReorderLevel})`);\nreturn [{ json: { message: `Low Stock Alert (${items.length} items)\\n` + lines.join('\\n') } }];"
      },
      "id": "code1",
      "name": "Format Alert Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "operation": "toText",
        "content": "={{$json.message}}"
      },
      "id": "noop1",
      "name": "Send Notification (replace with Email/Slack node)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 220]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Get Low Stock Items", "type": "main", "index": 0 }]] },
    "Get Low Stock Items": { "main": [[{ "node": "Any Low Stock Items?", "type": "main", "index": 0 }]] },
    "Any Low Stock Items?": { "main": [[{ "node": "Format Alert Message", "type": "main", "index": 0 }], []] },
    "Format Alert Message": { "main": [[{ "node": "Send Notification (replace with Email/Slack node)", "type": "main", "index": 0 }]] }
  }
}
